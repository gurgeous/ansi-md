{
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "prettier": {
    "astroAllowShorthand": true,
    "bracketSameLine": true,
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ],
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "./src/lib/plugins/prettier-plugin-align-type-comments.mjs"
    ],
    "printWidth": 120
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.4",
    "@catppuccin/palette": "^1.8.0",
    "@eslint/compat": "^2.0.5",
    "@iconify-json/lucide": "^1.2.104",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-scale-chromatic": "^3",
    "@types/node": "^25.5.0",
    "astro": "^6.1.2",
    "astro-auto-import": "^0.5.1",
    "astro-icon": "^1.1.5",
    "colorjs.io": "^0.6.1",
    "d3-scale-chromatic": "^3.1.0",
    "es-toolkit": "^1.46.0",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "sprintf-js": "^1.1.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.1",
    "unist-util-visit": "^5.1.0",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "@types/sprintf-js": "^1"
  }
