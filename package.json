    "@eslint/compat": "^2.0.5",
    "@iconify-json/lucide": "^1.2.118",
    "@shikijs/themes": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale-chromatic": "^3",
    "@types/node": "^26.1.1",
    "acorn": "^8.17.0",
    "astro": "^7.1.1",
    "astro-icon": "^1.1.5",
    "colorjs.io": "^0.7.0",
    "d3-scale-chromatic": "^3.1.0",
    "es-toolkit": "^1.46.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
