    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "sprintf-js": "^1.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unist-util-visit": "^5.1.0",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
