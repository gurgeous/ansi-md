---
import type { DocPage } from "@/lib/site";

const { page } = Astro.props as { page: DocPage };
---

<article>
  <header>
    <h1>{page.title}</h1>
  </header>

  <section class="intro">
    {page.description.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  {
    page.sections.map((section) => (
      <section class={section.id}>
        <a class="section-anchor" name={section.id} />
        <h2>{section.title}</h2>
        {section.body?.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {section.items && (
          <ul>
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
        {section.terms && (
          <dl>
            {section.terms.map((term) => (
              <>
                <dt>{term.term}</dt>
                <dd>{term.description}</dd>
              </>
            ))}
          </dl>
        )}
        {section.table && (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  {section.table.headers.map((header) => (
                    <th>{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {section.table.rows.map((row) => (
                  <tr>{row.map((cell, index) => (index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {section.code && (
          <pre>
            <code>{section.code}</code>
          </pre>
        )}
      </section>
    ))
  }

  {
    page.seeAlso && (
      <section class="see-also">
        <a class="section-anchor" name="see-also" />
        <h2>See Also</h2>
        <p>
          {page.seeAlso.map((item, index) => (
            <>
              {index > 0 && ", "}
              <a href={item.href}>{item.label}</a>
            </>
          ))}
        </p>
      </section>
    )
  }
</article>
