---
import { chapters } from "@/lib/chapters";
---

<nav>
  <h2 class="text-3xl font-bold">Pages</h2>
  <ul class="mt-4">
    {
      chapters.map((c, ii) => (
        <li>
          {ii}. <a href={c.url}>{c.name}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* remind */

  nav {
    @apply border-brand w-64 gap-3 border-b-2;
    @apply shrink-0 flex-col border-r-2 px-6 py-10 leading-tight;
    @apply hidden lg:block;
  }

  ul {
    @apply flex flex-col gap-1 text-xs;
  }

  a {
    @apply font-semibold text-sky-600 hover:brightness-80;
  }
</style>
