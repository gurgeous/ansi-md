---
import {chapters} from "@/lib/chapters";
---

<nav>
  <h2 class="font-bold text-xl">Chapters</h2>
  <ul>
    {chapters.map((c, i) => (<li>{c.num}. <a href={c.url}>{c.name}</a></li>))}
  </ul>
</nav>

<style>
  /* remind */

  nav {
    @apply border-brand gap-3 border-b-2 w-64;
    @apply flex-col shrink-0 border-r-2 px-6 py-10 leading-tight;
    @apply hidden lg:block;
  }

  ul {
    @apply font-semibold text-sky-600 flex flex-col gap-1 mt-4 text-xs;
  }

  a {
    @apply hover:brightness-80;
  }
</style>
