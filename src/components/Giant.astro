---
import Color from "colorjs.io";
import { sprintf } from "sprintf-js";
import { ansi256, tailwind } from "@/lib/palettes";

type Row = { name: string; hex: string };

const WHITE = new Color("#ffffff");
const BLACK = new Color("#000000");

const rows: Row[] = [];
rows.push(...Object.entries(ansi256).map(([name, hex]) => ({ name: `ansi 256 #${name}`, hex })));
rows.push(...flatten(tailwind));

//
// helpers
//

function row(name: string, hex: string): Row {
  return { name, hex };
}

function flatten(palette: Record<string, Record<string, string>>): Row[] {
  return Object.entries(palette).flatMap(([group, colors]) => {
    return Object.entries(colors).map(([name, hex]) => ({ name: `tw ${group}-${name}`, hex }));
  });
}

function apca(fg: Color | string, bg: Color | string): number {
  return new Color(bg).contrastAPCA(new Color(fg));
}

function contrast(fg: Color | string, bg: Color | string): string {
  return sprintf("APCA %d", apca(fg, bg));
}

function readable(fg: Color | string, bg: Color | string): boolean {
  return Math.abs(apca(fg, bg)) >= 40;
}

function dot(bg: Color | string): string {
  const white = Math.abs(apca(WHITE, bg));
  const black = Math.abs(apca(BLACK, bg));
  return white > black ? "#ffffff" : "#000000";
}
---

<table class="text-2xs! w-auto overflow-x-auto leading-tight sm:text-xs!">
  <thead>
    <tr>
      <th class="hidden sm:table-cell">RGB</th>
      <th>Light Bg</th>
      <th>Dark Bg</th>
      <th>Light Fg</th>
      <th>Dark Fg</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map(({ name, hex }) => (
        <tr>
          <td class="hidden sm:table-cell">{hex}</td>
          <td>
            <span
              class:list={["bg-white", { "apca-ok": readable(hex, WHITE) }]}
              style={`color:${hex};--dot:${dot(WHITE)}`}
              title={contrast(hex, WHITE)}>
              {name}
            </span>
          </td>
          <td>
            <span
              class:list={["bg-black", { "apca-ok": readable(hex, BLACK) }]}
              style={`color:${hex};--dot:${dot(BLACK)}`}
              title={contrast(hex, BLACK)}>
              {name}
            </span>
          </td>
          <td>
            <span
              class:list={{ "apca-ok": readable(WHITE, hex) }}
              style={`background:${hex};color:#fff;--dot:${dot(hex)}`}
              title={contrast(WHITE, hex)}>
              white
            </span>
          </td>
          <td>
            <span
              class:list={{ "apca-ok": readable(BLACK, hex) }}
              style={`background:${hex};color:#000;--dot:${dot(hex)}`}
              title={contrast(BLACK, hex)}>
              black
            </span>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  table {
    th,
    td {
      @apply text-center;
    }
    td {
      @apply border-0 p-0;
      &:first-child {
        @apply border-x;
      }
      &:last-child {
        @apply border-r;
      }
    }
    tr:last-child {
      td {
        @apply border-b;
      }
    }
  }

  span {
    @apply relative block cursor-default px-2 py-1 whitespace-nowrap;
  }

  .apca-ok::before {
    content: "";
    background: var(--dot);
    @apply absolute top-1/2 left-1 size-0.75 -translate-y-1/2 rounded-full;
    @apply sm:left-1.5 sm:size-1;
  }
</style>
