---
import Color from "colorjs.io";
import { sprintf } from "sprintf-js";
import { ansi256, tailwind } from "@/lib/palettes";

type Row = { name: string; hex: string };

const WHITE = new Color("#ffffff");
const BLACK = new Color("#000000");

const rows: Row[] = [];
rows.push(...Object.entries(ansi256).map(([name, hex]) => ({ name: `ansi 256 #${name}`, hex })));
rows.push(...flatten(tailwind));

//
// helpers
//

function row(name: string, hex: string): Row {
  return { name, hex };
}

function flatten(palette: Record<string, Record<string, string>>): Row[] {
  return Object.entries(palette).flatMap(([group, colors]) => {
    return Object.entries(colors).map(([name, hex]) => ({ name: `tw ${group}-${name}`, hex }));
  });
}

function contrast(fg: Color | string, bg: Color | string): string {
  return sprintf("contrast %.2f", new Color(bg).contrastAPCA(new Color(fg)));
}
---

<table class="w-auto overflow-x-auto text-xs! leading-tight">
  <thead>
    <tr>
      <th class="hidden sm:table-cell">RGB</th>
      <th>Light Bg</th>
      <th>Dark Bg</th>
      <th>Light Fg</th>
      <th>Dark Fg</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map(({ name, hex }) => (
        <tr>
          <td class="hidden sm:table-cell">{hex}</td>
          <td>
            <span class="bg-white" style={`color:${hex}`} title={contrast(hex, WHITE)}>
              {name}
            </span>
          </td>
          <td>
            <span class="bg-black" style={`color:${hex}`} title={contrast(hex, BLACK)}>
              {name}
            </span>
          </td>
          <td>
            <span style={`background:${hex};color:#fff`} title={contrast(WHITE, hex)}>
              white
            </span>
          </td>
          <td>
            <span style={`background:${hex};color:#000`} title={contrast(BLACK, hex)}>
              black
            </span>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  table {
    th,
    td {
      @apply text-center;
    }
    td {
      @apply border-0 p-0;
      &:first-child {
        @apply border-x;
      }
      &:last-child {
        @apply border-r;
      }
    }
    tr:last-child {
      td {
        @apply border-b;
      }
    }
  }

  span {
    @apply block px-2 py-1 whitespace-nowrap;
  }
</style>
