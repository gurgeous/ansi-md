---
import { ansi256LanguageLabels, languages, renderAnsi256 } from "@/lib/ansi256";
import { hexColorChipTransformer } from "@/lib/shikiColorChips";
import { Code } from "astro:components";
import { Icon } from "astro-icon/components";

const codeSamples = Object.fromEntries(languages.map((language) => [language, renderAnsi256(language)]));
const codeTransformers = [hexColorChipTransformer()];
const serializedCodeSamples = JSON.stringify(codeSamples).replaceAll("</", "<\\/");
---

<section class="ansi256-reference">
  <a class="section-anchor" name="reference"></a>
  <h2>Reference</h2>
  <p>
    The fixed part of the xterm 256-color palette starts at code 16. Codes 0-15 are deliberately omitted here: terminals
    treat them as theme slots, so their RGB values are not portable.
  </p>
  <p>
    Each source entry stores only a name and a hex value. The terminal code is array index plus 16, and RGB triples are
    derived from hex when a renderer or tool needs integers. The source's <code>Grey0</code> entry is named
    <code>Black</code> here because that is how people usually want to use code 16.
  </p>
  <p>
    Source names and values come from
    <a href="https://vim.fandom.com/wiki/Xterm256_color_names_for_console_Vim">Xterm256 color names for console Vim</a>.
    For escape sequence details, see <a href="/ansi#color">ANSI color forms</a>; for capability gates, see
    <a href="/capabilities#terminfo">terminfo</a> and <a href="/toolbox">toolbox probes</a>.
  </p>

  <h3>Constants</h3>
  <div class="language-picker" data-code-picker>
    <script type="application/json" data-code-samples set:html={serializedCodeSamples} />
    <div class="language-picker-bar" aria-label="Language">
      {
        languages.map((language, index) => (
          <button
            class={index === 0 ? "is-active" : ""}
            type="button"
            data-language={language}
            aria-pressed={index === 0 ? "true" : "false"}>
            {ansi256LanguageLabels[language]}
          </button>
        ))
      }
      <button type="button" data-copy aria-label="Copy code" title="Copy code">
        <Icon name="lucide:clipboard" data-copy-icon />
        <Icon name="lucide:clipboard-check" class="is-hidden" data-check-icon />
        <span data-copy-label>copy</span>
      </button>
    </div>

    {
      languages.map((language, index) => (
        <Code
          code={codeSamples[language]}
          class={index === 0 ? "" : "is-hidden"}
          data-sample={language}
          lang={language}
          theme="github-dark"
          transformers={codeTransformers}
        />
      ))
    }
  </div>
</section>

<style>
  .ansi256-reference {
    @apply mt-10;
  }

  .language-picker {
    @apply mt-4;

    pre {
      @apply mt-0 max-h-96 border-neutral-800 bg-neutral-950 text-xs/4 text-neutral-100;

      code {
        @apply bg-transparent text-xs text-neutral-100;
      }
    }
  }

  .language-picker-bar {
    @apply bg-brand border-brand-dark flex flex-wrap items-stretch gap-1 border border-b-0 p-1;

    button {
      @apply inline-flex cursor-pointer items-center gap-1 border border-transparent bg-transparent px-2 py-1 text-sm text-white transition;

      &:hover,
      &.is-active {
        @apply text-brand-dark border-white bg-white;
      }

      svg {
        @apply size-4;
      }

      &[data-copy] {
        @apply ml-auto;

        &.is-copied {
          @apply border-green-300 bg-green-600 text-white;

          [data-copy-icon] {
            @apply hidden;
          }

          [data-check-icon] {
            @apply inline-block;
          }
        }
      }
    }
  }

  .hex-chip {
    @apply mr-1 inline-block h-3 w-3 border border-neutral-500 align-middle;
  }

  .is-hidden {
    @apply hidden;
  }

  .clipboard-fallback {
    @apply fixed top-0 left-0 h-px w-px opacity-0;
  }
</style>

<script>
  async function writeClipboard(text) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return;
      } catch {
        // Fall through for non-secure origins such as LAN dev-server URLs.
      }
    }

    const textarea = document.createElement("textarea");
    textarea.className = "clipboard-fallback";
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    document.body.append(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  }

  for (const picker of document.querySelectorAll("[data-code-picker]")) {
    const buttons = [...picker.querySelectorAll("[data-language]")];
    const samples = [...picker.querySelectorAll("[data-sample]")];
    const codeSamples = JSON.parse(picker.querySelector("[data-code-samples]")?.textContent ?? "{}");
    const copy = picker.querySelector("[data-copy]");

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const language = button.getAttribute("data-language");
        for (const nextButton of buttons) {
          const active = nextButton === button;
          nextButton.classList.toggle("is-active", active);
          nextButton.setAttribute("aria-pressed", String(active));
        }
        for (const sample of samples) {
          sample.classList.toggle("is-hidden", sample.getAttribute("data-sample") !== language);
        }
      });
    }

    copy?.addEventListener("click", async () => {
      const sample = samples.find((nextSample) => !nextSample.classList.contains("is-hidden"));
      const language = sample?.getAttribute("data-sample") ?? "";
      const text = codeSamples[language] ?? "";
      await writeClipboard(text.trimEnd());
      copy.classList.add("is-copied");
      copy.setAttribute("aria-label", "Copied");
      const label = copy.querySelector("[data-copy-label]");
      if (label) label.textContent = "copied!";
      setTimeout(() => {
        copy.classList.remove("is-copied");
        copy.setAttribute("aria-label", "Copy code");
        if (label) label.textContent = "copy";
      }, 1200);
    });
  }
</script>
