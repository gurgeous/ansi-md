---
import Table from "@/components/Table.astro";
import { ansi256Sections, ansi256View } from "@/lib/palettes/ansi256-view.ts";
import { hex256 } from "@/lib/palettes";
---

<div class="ansi256-code">
  <Table name="ansi256" table={ansi256View} comment={hex256} sections={ansi256Sections} />
</div>

<style>
  .ansi256-code {
    @apply max-h-[60vh] overflow-y-auto;
  }
</style>
