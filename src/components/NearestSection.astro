---
type Props = { title: string; swatch: string };
const { title, swatch } = Astro.props;
---

<section class="nearest-section">
  <!-- title -->
  <p class="text-xs font-semibold text-neutral-500 uppercase">{title}</p>

  <!-- row -->
  <div class="mt-2 flex items-center gap-3 text-xs/2 sm:text-sm">
    <!-- swatch -->
    <svg viewBox="0 0 32 32" aria-hidden="true" class="size-8 shrink-0 border border-neutral-400">
      <rect width="32" height="32" fill="#d4d4d4" data-swatch={swatch}></rect>
    </svg>

    <!-- empty -->
    <div data-empty class="hidden leading-2 text-neutral-400">
      <span class="hidden pr-1.5 sm:inline-block">patiently</span>
      awaiting input
    </div>

    <!-- full / slot -->
    <div data-full class="flex items-center gap-3">
      <slot />
    </div>
  </div>
</section>

<style>
  /* prettier-ignore */
  :global(.is-empty) .nearest-section {
    /* prettier-ignore */
    svg { @apply opacity-40 } /* prettier-ignore */
    [data-empty] { @apply block } /* prettier-ignore */
    [data-full] { @apply hidden }
  }
</style>
