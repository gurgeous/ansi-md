---
import { chapters } from "@/lib/chapters";
---

<nav>
  {
    chapters.map((section, index) => (
      <section>
        <h2 class="text-2xl font-bold">{section.name}</h2>
        <ol start="0">
          {section.items.map((item) => (
            <li>
              <a href={item.url}>{item.name}</a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</nav>

<style>
  nav {
    @apply border-brand w-64 shrink-0 flex-col gap-3 border-r-2 px-6 py-10 leading-tight;
    @apply hidden lg:block
  }

  section:not(:first-child) {
    @apply mt-6;
  }

  ol {
    @apply flex flex-col gap-1.5 pl-6 text-xs leading-tight pt-1;
    li {
      @apply mt-1.5;
    }
    li::marker {
      @apply text-neutral-400;
    }
  }

  a {
    @apply font-semibold text-sky-600 hover:brightness-80;
  }
</style>
