---
import CodePicker from "@/components/CodePicker.astro";
import { languages, type LangKey } from "@/lib/code/code";
import type { Palette } from "@/lib/palettes";

type Props = { name: string; palette: Palette };
const { name, palette } = Astro.props;

const snippets = Object.fromEntries(
  languages.map((language) => [language.name, language.render(name, palette)]),
) as Record<LangKey, string>;
---

<CodePicker {languages} {snippets} />
