---
import Ansi from "@/lib/ansi.ts";
import { namedColors } from "@/lib/color.ts";
import { tailwind } from "@/lib/palettes";
import NearestSection from "@/components/NearestSection.astro";

const data = JSON.stringify({
  ansi256: Ansi.colors256,
  tailwind: namedColors(tailwind),
});
---

<div class="nearest is-empty mt-10">
  <!-- json data -->
  <script is:inline type="application/json" set:html={data} />

  <!-- label / input -->
  <label>
    <div class="font-semibold text-neutral-950">Enter RGB hex</div>
    <input
      class="mt-2 max-w-sm border px-2 py-1 text-neutral-950"
      type="text"
      placeholder="#8caaee"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
    />
  </label>

  <!-- results -->
  <div class="mt-4 flex max-w-2xl flex-col gap-5">
    <!-- original -->
    <NearestSection title="original color" swatch="input">
      <code data-field="inputHex"></code>
    </NearestSection>

    <!-- 256 -->
    <NearestSection title="closest ANSI 256 color" swatch="ansi">
      <span class="flex flex-wrap items-baseline gap-2">
        <code data-field="ansiHex"></code>
        <strong>index <span data-field="ansiIndex"></span></strong>
      </span>
      <span class="hidden flex-wrap gap-2 sm:flex">
        <code data-field="ansiFg"></code>
        <code data-field="ansiBg"></code>
      </span>
    </NearestSection>

    <!-- tailwind -->
    <NearestSection title="closest Tailwind color" swatch="tailwind">
      <span>
        <code data-field="tailwindHex"></code>
        <strong data-field="tailwindName"></strong>
      </span>
    </NearestSection>
  </div>
</div>

<script>
  import { initNearest } from "@/browser/nearest";
  initNearest();
</script>
