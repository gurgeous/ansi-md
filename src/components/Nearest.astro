---
import Ansi from "@/lib/ansi.ts";
import { ansi256, ansi256Table, tailwind } from "@/lib/palettes";
import NearestSection from "@/components/NearestSection.astro";

const ansi256Names: Record<string, string> = {};
for (const [name, index] of Object.entries(ansi256Table)) {
  const current = ansi256Names[index];
  if (!current || (/\d/.test(current) && !/\d/.test(name))) ansi256Names[index] = name;
}
const data = JSON.stringify({ ansi256, ansi256Names, tailwind });
---

<div class="nearest is-empty mt-10 flex items-start gap-4 lg:gap-10">
  <!-- json data -->
  <script is:inline type="application/json" set:html={data} />

  <div class="min-w-0 flex-1">
    <!-- label / input -->
    <label>
      <div class="font-semibold text-neutral-950">Enter RGB hex</div>
      <input
        class="mt-2 max-w-sm border px-2 py-1 text-neutral-950"
        type="text"
        placeholder="#8caaee"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </label>

    <!-- results -->
    <div class="mt-4 flex max-w-2xl flex-col gap-5">
      <!-- original -->
      <NearestSection title="you entered" swatch="input">
        <code data-field="inputHex"></code>
      </NearestSection>

      <!-- 256 -->
      <NearestSection title="closest ANSI 256 color" swatch="ansi">
        <span class="flex flex-wrap items-baseline gap-2">
          <code data-field="ansiHex"></code>
          <strong>color #<span data-field="ansiIndex"></span></strong>
          <strong data-field="ansiName"></strong>
        </span>
      </NearestSection>

      <!-- tailwind -->
      <NearestSection title="closest Tailwind color" swatch="tailwind">
        <span class="flex flex-wrap items-baseline gap-2">
          <code data-field="tailwindHex"></code>
          <strong data-field="tailwindName"></strong>
        </span>
      </NearestSection>
    </div>
  </div>

  <figure class="mt-4 shrink-0">
    <canvas
      data-color-wheel
      width="320"
      height="320"
      aria-hidden="true"
      class="size-20 touch-none cursor-crosshair rounded-full lg:size-64"></canvas>
    <figcaption
      class="mt-2 hidden border-t border-neutral-200 pt-2 text-center text-xs text-neutral-500 lg:block"
    >
      Move your mouse over the wheel
    </figcaption>
  </figure>
</div>

<script>
  import { initNearest } from "@/browser/nearest";
  initNearest();
</script>
