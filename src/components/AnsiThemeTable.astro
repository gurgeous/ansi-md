---
import Ansi from "@/lib/ansi.ts";
import type { Colors } from "@/lib/palettes";

type Props = {
  colors: Colors;
  bright?: boolean;
};

const { colors, bright = false } = Astro.props;
const base = bright ? 8 : 0;
---

<table>
  <thead>
    <tr>
      <th>name</th>
      <th>rgb</th>
      <th>ansi16 fg</th>
      <th>ansi16 bg</th>
      <th>ansi256 fg</th>
      <th>ansi256 bg</th>
    </tr>
  </thead>
  <tbody>
    {
      Object.entries(colors).map(([name, hex], i) => (
        <tr>
          <td>
            <span class="inline-flex items-center gap-1.5">
              <svg class="size-4 shrink-0 border border-neutral-400">
                <rect width="16" height="16" fill={hex} />
              </svg>
              <span>{name}</span>
            </span>
          </td>
          <td>
            <code>{hex}</code>
          </td>
          <td>
            <code>{Ansi.fg16(i, bright)}</code>
          </td>
          <td>
            <code>{Ansi.bg16(i, bright)}</code>
          </td>
          <td>
            <code>{Ansi.fg256(base + i)}</code>
          </td>
          <td>
            <code>{Ansi.bg256(base + i)}</code>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
