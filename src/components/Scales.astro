---
import CodePicker from "@/components/CodePicker.astro";
import { languages, type Scales, type LangKey } from "@/lib/code/code";

type Props = { name: string; scales: Scales };
const { name, scales } = Astro.props;

const snippets = Object.fromEntries(
  languages.map((language) => [language.name, language.renderScales(name, scales)]),
) as Record<LangKey, string>;
---

<section class="mt-5">
  <CodePicker {languages} {snippets} />
</section>
