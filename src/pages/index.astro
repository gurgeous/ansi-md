---
import { navGroups } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const descriptions: Record<string, string> = {
  "/": "cover page and site map",
  "/getting-started": "reading path, first decisions, safe output baseline, checklist",
  "/ansi": "escape sequences, SGR styling, color forms, cursor movement, OSC notes",
  "/toolbox": "color conversion, contrast checks, ANSI 256 lookup, terminal probe commands",
  "/capabilities": "TERM, COLORTERM, terminfo, tput, compatibility, Unicode width",
  "/color": "semantic color, 256-color palettes, truecolor, contrast rules",
  "/cli-renaissance": "recommended modern tools such as bat, fd, ripgrep, fzf, yazi, zoxide",
  "/progress": "spinners, progress bars, redraw loops, cleanup rules",
  "/patterns": "human output, JSON output, shell integration, testing",
  "/libraries": "recommended parsers, output helpers, prompt libraries, and TUI frameworks",
  "/images": "sixel, Kitty graphics, iTerm2 images, chafa",
  "/appendix": "history, accessibility, safety, glossary, references",
};

const docClass = "w-full px-4 py-5 md:px-8 xl:px-14";
const headClass = "mb-7 max-w-[78ch] border-b border-neutral-200 pb-4";
const h1Class = "text-balance text-4xl leading-tight font-bold text-neutral-950 md:text-5xl xl:text-6xl";
const h2Class = "mt-9 mb-3 max-w-[78ch] border-b border-neutral-200 pb-1 text-xl font-bold text-neutral-950";
const proseClass = "mb-3 max-w-[78ch] [overflow-wrap:anywhere] leading-relaxed text-neutral-950";
const preClass =
  "mb-5 max-w-full overflow-x-auto border-l-4 border-neutral-200 bg-neutral-50 p-4 font-mono leading-relaxed";
---

<Layout
  title="ansi.md - terminal reference"
  description="A terse reference for ANSI escape codes, terminal capabilities, CLI tools, and TUI craft.">
  <article class={docClass}>
    <header class={headClass}>
      <h1 class={h1Class}>ansi.md</h1>
    </header>

    <section id="synopsis">
      <h2 class={h2Class}>Synopsis</h2>
      <pre
        class={preClass}><code>ansi.md
ansi.md/getting-started
ansi.md/ansi
ansi.md/toolbox
ansi.md/libraries</code></pre>
    </section>

    <section id="description">
      <h2 class={h2Class}>Description</h2>
      <p class={proseClass}>
        ansi.md is a reference for ANSI escape codes, terminal capability detection, command output, progress renderers,
        modern CLI tools, and TUI libraries.
      </p>
      <p class={proseClass}>
        The site is intentionally plain. It should read like a maintained manual page or Markdown file: stable section
        headings, examples, dense tables, and few distractions.
      </p>
    </section>

    <section id="contents">
      <h2 class={h2Class}>Contents</h2>
      {
        navGroups.map((group) => (
          <section class="mb-5">
            <h3 class="mb-2 max-w-[78ch] font-mono text-sm font-bold text-neutral-500 uppercase">{group.label}</h3>
            <dl class="mb-4 grid max-w-[96ch] grid-cols-1 gap-x-4 gap-y-1 leading-relaxed md:grid-cols-[minmax(8rem,15rem)_minmax(0,1fr)]">
              {group.items.map((item) => (
                <>
                  <dt class="font-mono font-bold">
                    <a class="text-blue-700 underline underline-offset-2" href={item.href}>
                      {item.label}
                    </a>
                  </dt>
                  <dd class="m-0 [overflow-wrap:anywhere]">{descriptions[item.href]}</dd>
                </>
              ))}
            </dl>
          </section>
        ))
      }
    </section>

    <section id="rules">
      <h2 class={h2Class}>Rules</h2>
      <ul class="mb-4 max-w-[78ch] list-disc space-y-1 pl-6 leading-relaxed">
        <li>Reset styles before returning control to the shell.</li>
        <li>Respect non-TTY output, NO_COLOR, CI, and user configuration.</li>
        <li>Prefer plain text and stable exit codes over clever presentation.</li>
        <li>Use color, motion, and full-screen interfaces only when they clarify the task.</li>
        <li>Keep examples pasteable and recovery commands close at hand.</li>
      </ul>
    </section>
  </article>
</Layout>
