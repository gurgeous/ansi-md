---
import { navGroups } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const descriptions: Record<string, string> = {
  "/": "cover page and site map",
  "/getting-started": "reading path, first decisions, safe output baseline, checklist",
  "/ansi": "escape sequences, SGR styling, color forms, cursor movement, OSC notes",
  "/toolbox": "color conversion, contrast checks, ANSI 256 lookup, terminal probe commands",
  "/capabilities": "TERM, COLORTERM, terminfo, tput, compatibility, Unicode width",
  "/color": "semantic color, 256-color palettes, truecolor, contrast rules",
  "/cli-renaissance": "recommended modern tools such as bat, fd, ripgrep, fzf, yazi, zoxide",
  "/progress": "spinners, progress bars, redraw loops, cleanup rules",
  "/patterns": "human output, JSON output, shell integration, testing",
  "/libraries": "recommended parsers, output helpers, prompt libraries, and TUI frameworks",
  "/images": "sixel, Kitty graphics, iTerm2 images, chafa",
  "/appendix": "history, accessibility, safety, glossary, references",
};
---

<Layout title="Ansi.md - terminal reference">
  <article>
    <header>
      <h1>Ansi.md</h1>
    </header>

    <section class="intro">
      <p>
        Ansi.md is a reference for ANSI escape codes, terminal capability detection, command output, progress renderers,
        modern CLI tools, and TUI libraries.
      </p>
      <p>
        The site is intentionally plain. It should read like a maintained manual page or Markdown file: stable section
        headings, examples, dense tables, and few distractions.
      </p>
    </section>

    <section class="contents">
      <a class="section-anchor" name="contents"></a>
      <h2>Contents</h2>
      {
        navGroups.map((group) => (
          <section>
            <h3>{group.label}</h3>
            <dl>
              {group.items.map((item) => (
                <>
                  <dt>
                    <a href={item.href}>{item.label}</a>
                  </dt>
                  <dd>{descriptions[item.href]}</dd>
                </>
              ))}
            </dl>
          </section>
        ))
      }
    </section>

    <section class="rules">
      <a class="section-anchor" name="rules"></a>
      <h2>Rules</h2>
      <ul>
        <li>Reset styles before returning control to the shell.</li>
        <li>Respect non-TTY output, NO_COLOR, CI, and user configuration.</li>
        <li>Prefer plain text and stable exit codes over clever presentation.</li>
        <li>Use color, motion, and full-screen interfaces only when they clarify the task.</li>
        <li>Keep examples pasteable and recovery commands close at hand.</li>
      </ul>
    </section>
  </article>
</Layout>
