---
import Ansi256Palette from "@/components/Ansi256Palette.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="ANSI 256 - Ansi.md">
  <article>
    <header>
      <h1>ANSI 256</h1>
    </header>

    <section class="intro">
      <p>
        ANSI 256 colors are the fixed xterm palette used by <code>38;5;n</code> foregrounds and
        <code>48;5;n</code> backgrounds. They are useful when 8 or 16 semantic slots are too small, but truecolor is unnecessary
        or unavailable.
      </p>
    </section>

    <Ansi256Palette />
  </article>
</Layout>
