---
import "../main.css";
import { navGroups } from "@/data/site";
import logoUrl from "@/assets/logo.png?url";
import { Font } from "astro:assets";

const { title = "Ansi.md" } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={logoUrl} />
    <Font cssVariable="--font-ibm-plex-mono" preload />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" aria-label="Ansi.md home">Ansi.md</a>
    </header>
    <div>
      <aside>
        <nav aria-label="Table of contents">
          <h2>Contents</h2>
          {
            navGroups.map((group) => (
              <section>
                <h3>{group.label}</h3>
                <div>
                  {group.items.map((item) => (
                    <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                      {item.label}
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </nav>
      </aside>
      <div>
        <main>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
