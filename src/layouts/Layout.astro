---
import "../styles/main.css";
import faviconUrl from "@/assets/favicon.svg?url";
import { navGroups } from "@/data/site";

const {
  title = "ansi.md",
  description = "A practical reference for building beautiful command line and terminal user interfaces.",
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{title}</title>
  </head>
  <body class="m-0 min-w-80 bg-white font-sans text-base tracking-normal text-neutral-950">
    <header
      class="flex w-full flex-wrap items-baseline gap-x-5 gap-y-2 border-b border-neutral-200 px-4 py-3 md:px-8 xl:px-14">
      <a
        class="inline-flex items-center gap-2 font-mono font-bold text-neutral-950 no-underline"
        href="/"
        aria-label="ansi.md home">
        <img class="size-7" src={faviconUrl} alt="" width="28" height="28" />
        <span>ansi.md</span>
      </a>
    </header>
    <div
      class="min-h-[calc(100svh-3.25rem)] md:grid md:grid-cols-[14rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)]">
      <aside
        class="border-b border-neutral-200 bg-neutral-50 px-3 py-3 md:border-r md:border-b-0 md:px-8 md:py-6 xl:pl-14">
        <nav class="grid min-w-0 content-start gap-3 text-[0.92rem] md:sticky md:top-4" aria-label="Table of contents">
          <h2 class="w-full font-mono text-xs font-bold text-neutral-500 uppercase md:mb-1">Contents</h2>
          {
            navGroups.map((group) => (
              <section class="min-w-0">
                <h3 class="mb-1 font-mono text-[0.72rem] font-bold tracking-normal text-neutral-500 uppercase">
                  {group.label}
                </h3>
                <div class="flex min-w-0 flex-wrap gap-x-3 gap-y-1 md:grid md:gap-y-1">
                  {group.items.map((item) => (
                    <a
                      class:list={[
                        "text-blue-700 underline underline-offset-2",
                        path === item.href && "font-bold text-neutral-950 no-underline",
                      ]}
                      href={item.href}
                      aria-current={path === item.href ? "page" : undefined}>
                      {item.label}
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </nav>
      </aside>
      <div class="min-w-0">
        <main>
          <slot />
        </main>
        <footer
          class="flex w-full flex-wrap justify-between gap-x-4 gap-y-1 border-t border-neutral-200 px-4 py-3 font-mono text-xs text-neutral-500 md:px-8 xl:px-14">
          <span>ansi.md</span>
        </footer>
      </div>
    </div>
  </body>
</html>
