---
import Layout from "@/layouts/Layout.astro";

type Frontmatter = {
  title: string;
  description: string;
};

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
---

<Layout title={`${frontmatter.title} - ansi.md`} description={frontmatter.description}>
  <article>
    <header>
      <h1>{frontmatter.title}</h1>
    </header>
    <slot />
  </article>
</Layout>
